config\n\n# SAM2 already loaded as predictor from Step 24\n# If kernel restarted, rebuild:\n# from sam2.build_sam import build_sam2\n# from sam2.sam2_image_predictor import SAM2ImagePredictor\n# sam2_model = build_sam2('sam2_hiera_s.yaml',\n#     '/kaggle/working/sam2/sam2_hiera_small.pt', device=DEVICE)\n# predictor = SAM2ImagePredictor(sam2_model)\n\nresults = []\nskipped = 0\n\nfor lesion_dir in tqdm(sorted(TRAIN_IMG_DIR.iterdir()),\n                       desc='SAM2 masks', total=5240):\n    lesion_id = lesion_dir.name\n    imgs = list(lesion_dir.glob('*.jpg')) + list(lesion_dir.glob('*.jpeg'))\n    if not imgs:\n        skipped += 1\n        continue\n\n    isic_id = imgs[0].stem\n    try:\n        img_np = np.array(\n            Image.open(imgs[0]).convert('RGB').resize((224, 224)))\n        H, W   = img_np.shape[:2]\n\n        # Centre-prior box\n        cx, cy = W // 2, H // 2\n        bw, bh = int(W * BOX_SCALE), int(H * BOX_SCALE)\n        box    = np.array([cx-bw//2, cy-bh//2, cx+bw//2, cy+bh//2])\n\n        predictor.set_image(img_np)\n        masks, scores, _ = predictor.predict(\n            box=box, multimask_output=False)\n\n        mask = masks[0]\n        results.append({\n            'lesion_id' : lesion_id,\n            'isic_id'   : isic_id,\n            'coverage'  : float(mask.mean()),\n            'sam_score' : float(scores[0]),\n        })\n    except Exception as e:\n        skipped += 1\n        results.append({\n            'lesion_id' : lesion_id,\n            'isic_id'   : isic_id,\n            'coverage'  : 0.194,   # fallback = dataset mean\n            'sam_score' : 0.0,\n        })\n\ncov_df = pd.DataFrame(results)\ncov_df.to_csv(SAVE_PATH, index=False)\n\nprint(f'\\nDone.')\nprint(f'  Total    : {len(cov_df)}')\nprint(f'  Skipped  : {skipped}')\nprint(f'  Saved to : {SAVE_PATH}')\nprint(f'\\nCoverage stats:')\nprint(f'  mean : {cov_df[\"coverage\"].mean():.3f}')\nprint(f'  std  : {cov_df[\"coverage\"].std():.3f}')\nprint(f'  min  :