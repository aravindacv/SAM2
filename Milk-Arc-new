                            random_state=42, stratify=df[CLASSES].values.argmax(1))\nprint(f'Train: {len(train_df)}  Val: {len(val_df)}')\n\nclass MILK10kDataset(Dataset):\n    def __init__(self, df, img_dir, augment=False):\n        self.df      = df.reset_index(drop=True)\n        self.img_dir = Path(img_dir)\n        self.tfm     = T.Compose([\n            T.Resize((224, 224)),\n            T.RandomHorizontalFlip() if augment else T.Lambda(lambda x: x),\n            T.RandomVerticalFlip()   if augment else T.Lambda(lambda x: x),\n            T.ToTensor(),\n            T.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])\n        ])\n        # fill missing MONET cols with 0\n        for c in MONET_COLS:\n            if c not in df.columns:\n                self.df[c] = 0.0\n\n    def __len__(self): return len(self.df)\n\n    def __getitem__(self, idx):\n        row    = self.df.iloc[idx]\n        lid    = row['lesion_id']\n        # find jpg in lesion folder\n        folder = self.img_dir / lid\n        imgs   = list(folder.glob('*.jpg')) + list(folder.glob('*.jpeg'))\n        img    = Image.open(imgs[0]).convert('RGB')\n        img_t  = self.tfm(img)\n        monet  = torch.tensor(row[MONET_COLS].values.astype(np.float32))\n        label  = torch.tensor(row[CLASSES].values.astype(np.float32))\n        return img_t, monet, label, lid\n\ntrain_ds = MILK10kDataset(train_df, TRAIN_IMG_DIR, augment=True)\nval_ds   = MILK10kDataset(val_df,   TRAIN_IMG_DIR, augment=False)\n\ntrain_loader = DataLoader(train_ds, batch_size=16, shuffle=True,  num_workers=2, pin_memory=True)\nval_loader   = DataLoader(val_ds,   batch_size=16, shuffle=False, num_workers=2, pin_memory=True)\n\n# Test one batch\nimgs, monets, labels, lids = next(iter(train_loader))\nprint(f'\\nBatch test:')\nprint(f'  imgs   : {imgs.shape}')\nprint(f'  monets : {monets.shape}')\nprint(f'  labels : {labels.shape}')\nprint(f'  lids   : {lids[0]}')\nprint(f'  label sum per sample (should be 1.0): {labels.sum(1)[: