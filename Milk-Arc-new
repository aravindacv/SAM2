===================\n#  SETUP — restore files + define paths, classes and ARCMEDV3\n# ============================================================\nimport shutil, zipfile, torch, torch.nn as nn, timm, numpy as np, pandas as pd\nfrom pathlib import Path\n\n# ── 1. Restore yesterday's files ──\nSRC = Path('/kaggle/input/datasets/cvaravinda/skinfaith-results-20261023-1801')\nW   = Path('/kaggle/working')\nfor z in SRC.rglob('*.zip'):\n    zipfile.ZipFile(z).extractall(W)\nfor f in SRC.rglob('*'):\n    if f.is_file() and f.suffix != '.zip':\n        shutil.copy2(f, W/f.name)\nfor n in ['rarederm_merged_df.csv', 'rarederm_split_rebuilt.json', 'rarederm_TEST_results.csv',\n          'milk10k_sam2_coverage_DERM.csv', 'milk10k_sam2_masks_DERM.npz']:\n    print(('  ✅ ' if (W/n).exists() else '  ❌ ') + n)\n\n# ── 2. Paths and constants ──\nDEVICE   = 'cuda'\nROOT     = Path('/kaggle/input/datasets/cvaravinda/milkydatset/MILK10_2024')\nIMGDIR   = ROOT/'MILK10k_Training_Input'/'MILK10k_Training_Input'\nCK       = Path('/kaggle/input/models/cvaravinda/checkpoints/pytorch/default/1/checkpoints')\nCLASSES  = ['AKIEC','BCC','BEN_OTH','BKL','DF','INF','MAL_OTH','MEL','NV','SCCKA','VASC']\nMINORITY = ['MAL_OTH','VASC','INF','DF','BEN_OTH']\nMONET    = ['MONET_ulceration_crust','MONET_hair','MONET_vasculature_vessels','MONET_erythema',\n            'MONET_pigmented','MONET_gel_water_drop_fluid_dermoscopy_liquid',\n            'MONET_skin_markings_pen_ink_purple_pen']\nprint('  ✅ checkpoint found' if (CK/'best_arcmed_v3.pt').exists() else '  ❌ ARCMED checkpoint missing')\n\n# ── 3. ARCMED V3 architecture (matches the checkpoint, 0 missing keys) ──\nclass MonetProjector(nn.Module):\n    def __init__(s): super().__init__(); s.proj = nn.Sequential(nn.Linear(7,64), nn.ReLU(), nn.Linear(64,128))\n    def forward(s, x): return s.proj(x)\nclass AttentionGate(nn.Module):\n    def __init__(s):\n        super().__init__()\n        s.gate = nn.Sequential(nn.Linear(3072,1536), nn.ReLU(), nn.Linear(1536,3072), nn.Sigmoid())\n    def forward(s, x): return (x * s.gate(x))[:, :1536]\nclass DualStreamEncoder(nn.Module):\n    def __init__(s):\n        super().__init__()\n        s.stream1 = timm.create_model('efficientnet_b3', pretrained=False, num_classes=0)\n        s.stream2 = timm.create_model('efficientnet_b3', pretrained=False, num_classes=0)\n        s.monet_proj = MonetProjector(); s.attention_gate = AttentionGate()\n        s.final_proj = nn.Sequential(nn.Linear(3200,1536), nn.BatchNorm1d(1536))\n    def forward(s, x, monet):\n        proj = s.final_proj(torch.cat([s.stream1(x), s.stream2(x), s.monet_proj(monet)], 1))\n        return s.attention_gate(torch.cat([proj, proj], 1))\nclass ARCMEDV3(nn.Module):\n    def __init__(s, num_classes=11, proto_dim=256):\n        super().__init__()\n        s.encoder = DualStreamEncoder()\n        s.standard_head = nn.Sequential(nn.Linear(1536,512), nn.GELU(), nn.Dropout(0.3), nn.Linear(512,num_classes))\n        s.prototypes  = nn.Parameter(torch.randn(num_classes, 5, proto_dim))\n        s.temperature = nn.Parameter(torch.ones([]))\n        s.proto_proj  = nn.Linear(1536, proto_dim)\n        s.router      = nn.Sequential(nn.Linear(1536,64), nn.ReLU(), nn.Linear(64,1))\n    def forward(s, x, monet): return s.standard_head(s.encoder(x, monet))\n\nm = ARCMEDV3()\nmiss, unexp = m.load_state_dict(torch.load(CK/'best_arcmed_v3.pt', map_location='cpu',\n                                           weights_only=False)['model'], strict=False)\nprint(f'  ARCMED load check: missing={len(miss)} unexpected={len(unexp)}  (expect 0 / 0)')\ndel m","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T05:05:25.962523Z","iopub.execute_input":"2026-10-24T05:05:25.963033Z","iopub.status.idle":"2026-10-24T05:05:37.075783Z","shell.execute_reply.started":"2026-10-24T05:05:25.962999Z","shell.execute_reply":"2026-10-24T05:05:37.07489Z"}},"outputs":[{"name":"stdout","text":"  ✅ rarederm_merged_df.csv\n  ✅ rarederm_split_rebuilt.json\n  ✅ rarederm_TEST_results.csv\n  ✅ milk10k_sam2_coverage_DERM.csv\n  ✅ milk10k_sam2_masks_DERM.npz\n  ✅ checkpoint found\n  ARCMED load check: missing=0 unexpected=0  (expect 0 / 0)\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"# ============================================================\n#  CELL 5 — Coverage-gated ARCMED V3 on DERMOSCOPIC images,\n#  aligned with the RareDerm train / val / test split\n# ============================================================\nimport torch, torch.nn as nn, numpy as np, pandas as pd, json\nimport torchvision.transforms as T\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom sklearn.metrics import roc_auc_score\nfrom tqdm import tqdm\ntorch.manual_seed(42); np.random.seed(42)\n\ndf    = pd.read_csv('/kaggle/working/rarederm_merged_df.csv')\nsplit = json.load(open('/kaggle/working/rarederm_split_rebuilt.json'))\ncov   = pd.read_csv('/kaggle/working/milk10k_sam2_coverage_DERM.csv')[['lesion_id', 'coverage']]\npart  = np.empty(len(df), dtype=object)\nfor k, n in [('train_idx','train'), ('val_idx','val'), ('test_idx','test')]: part[split[k]] = n\ndf['part'] = part\nD = df[df.image_type == 'dermoscopic'].merge(cov, on='lesion_id', how='left')\nD['coverage'] = D['coverage'].fillna(D['coverage'].mean())\nD[MONET] = D[MONET].fillna(0.0)\nTR, VA, TE = [D[D.part == p].reset_index(drop=True) for p in ['train', 'val', 'test']]\nprint(f'Dermoscopic lesions  train {len(TR)} | val {len(VA)} | test {len(TE)}')\n\nNORM = [T.ToTensor(), T.Normalize([0.485,0.456,0.406], [0.229,0.224,0.225])]\nclass DS(Dataset):\n    def __init__(s, d, aug):\n        s.d = d\n        s.t = T.Compose([T.Resize((224,224))] +\n                        ([T.RandomHorizontalFlip(), T.RandomVerticalFlip(),\n                          T.ColorJitter(0.1,0.1,0.1,0.05)] if aug else []) + NORM)\n    def __len__(s): return len(s.d)\n    def __getitem__(s, i):\n        r = s.d.iloc[i]\n        x = s.t(Image.open(IMGDIR/r.lesion_id/f'{r.isic_id}.jpg').convert('RGB'))\n        return (x, torch.tensor(r[MONET].values.astype(np.float32)),\n                torch.tensor(float(r.coverage)), torch.tensor(r[CLASSES].values.astype(np.float32)))\nmk = lambda d, aug, sh: DataLoader(DS(d, aug), batch_size=16, shuffle=sh, num_workers=2, pin_memory=True)\ntr_ld, va_ld, te_ld = mk(TR, True, True), mk(VA, False, False), mk(TE, False, False)\n\nclass CovGate(nn.Module):\n    def __init__(s, d=1536):\n        super().__init__(); s.cov_proj = nn.Linear(1, d)\n        s.gate = nn.Sequential(nn.Linear(2*d, d), nn.ReLU(), nn.Linear(d, d), nn.Sigmoid())\n    def forward(s, f, c): return f * s.gate(torch.cat([f, s.cov_proj(c[:, None])], 1))\nclass CovARCMED(nn.Module):\n    def __init__(s, base): super().__init__(); s.base = base; s.mask_gate = CovGate()\n    def forward(s, x, m, c): return s.base.standard_head(s.mask_gate(s.base.encoder(x, m), c))\n\ndef load_base():\n    b = ARCMEDV3(); b.load_state_dict(torch.load(CK/'best_arcmed_v3.pt', map_location='cpu',\n                                                  weights_only=False)['model'], strict=False)\n    return b.to(DEVICE)\n\ndef predict(model, loader, gated):\n    model.eval(); P, Yv = [], []\n    with torch.no_grad():\n        for x, m, c, y in loader:\n            x, m, c = x.to(DEVICE), m.to(DEVICE), c.to(DEVICE)\n            out = model(x, m, c) if gated else model(x, m)\n            P.append(torch.sigmoid(out).cpu().numpy()); Yv.append(y.numpy())\n    return np.concatenate(P), np.concatenate(Yv)\n\ndef macro_rare(P, Yv):\n    a = {c: roc_auc_score(Yv[:,i], P[:,i]) for i, c in enumerate(CLASSES) if 0 < Yv[:,i].sum() < len(Yv)}\n    return np.mean(list(a.values())), np.mean([a[c] for c in MINORITY if c in a])\n\n# ── Train (same two-phase recipe as the original run) ──\nmodel = CovARCMED(load_base()).to(DEVICE)\ncnt = TR[CLASSES].sum(0).values.clip(min=1)\ncrit = nn.BCEWithLogitsLoss(pos_weight=torch.tensor(np.clip(cnt.sum()/(11*cnt), 0, 10),\n                                                    dtype=torch.float32, device=DEVICE))\nbest, BEST = 0.0, '/kaggle/working/arcmed_covgate_DERM.pt'\nfor n_ep, lr, freeze, label in [(2, 1e-4, True, 'Phase 1 (encoder frozen)'),\n                                (5, 3e-5, False, 'Phase 2 (end to end)')]:\n    for p in model.base.parameters(): p.requires_grad = not freeze\n    for p in list(model.mask_gate.parameters()) + list(model.base.standard_head.parameters()):\n        p.requires_grad = True\n    opt = torch.optim.AdamW([p for p in model.parameters() if p.requires_grad], lr=lr, weight_decay=1e-4)\n    sch = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=n_ep)\n    print(f'\\n{label}  lr={lr}')\n    for ep in range(1, n_ep+1):\n        model.train(); tot = 0\n        for x, m, c, y in tqdm(tr_ld, leave=False, desc=f'ep{ep}'):\n            x, m, c, y = x.to(DEVICE), m.to(DEVICE), c.to(DEVICE), y.to(DEVICE)\n            opt.zero_grad(); loss = crit(model(x, m, c), y); loss.backward()\n            nn.utils.clip_grad_norm_(model.parameters(), 1.0); opt.step(); tot += loss.item()\n        sch.step()\n        vm, vr = macro_rare(*predict(model, va_ld, True))\n        flag = ''\n        if vm > best: best = vm; torch.save(model.state_dict(), BEST); flag = '  ✅ saved'\n        print(f'  ep{ep} loss={tot/len(tr_ld):.4f} | val macro={vm:.4f} rare={vr:.4f}{flag}')\n\n# ── Held-out TEST: original vs coverage-gated, paired bootstrap ──\nmodel.load_state_dict(torch.load(BEST))\nPg, Yt = predict(model, te_ld, True)\nbase   = load_base()\nPb, _  = predict(base, te_ld, False)\nbm, br = macro_rare(Pb, Yt); gm, gr = macro_rare(Pg, Yt)\nrng = np.random.default_rng(42); dm, dr = [], []\nfor _ in range(1000):\n    i = rng.integers(0, len(Yt), len(Yt))\n    if (Yt[i].sum(0) == 0).any(): continue\n    a1, b1 = macro_rare(Pb[i], Yt[i]); a2, b2 = macro_rare(Pg[i], Yt[i])\n    dm.append(a2 - a1); dr.append(b2 - b1)\nlo, hi = np.percentile(dm, [2.5, 97.5]); rlo, rhi = np.percentile(dr, [2.5, 97.5])\nnp.save('/kaggle/working/covgate_test_probs.npy', Pg); np.save('/kaggle/working/base_test_probs_derm.npy', Pb)\nTE[['lesion_id', 'isic_id']].to_csv('/kaggle/working/covgate_test_lesions.csv', index=False)\n\nprint('\\n' + '='*62)\nprint(f'TEST (dermoscopic, n={len(TE)}, rare images={int(TE[MINORITY].values.sum())})')\nprint(f'  Original ARCMED V3   macro={bm:.4f}  rare={br:.4f}')\nprint(f'  Coverage-gated       macro={gm:.4f}  rare={gr:.4f}')\nprint(f'  Δ macro = {gm-bm:+.4f}  95% CI [{lo:+.4f}, {hi:+.4f}]  (paired bootstrap, {len(dm)} resamples)')\nprint(f'  Δ rare  = {gr-br:+.4f}  95% CI [{rlo:+.4f}, {rhi:+.4f}]')\nprint(f'  Best validation macro = {best:.4f}')\nprint('='*62)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T05:06:16.661641Z","iopub.execute_input":"2026-10-24T05:06:16.662237Z"}},"outputs":[{"name":"stdout","text":"Dermoscopic lesions  train 3671 | val 791 | test 778\n\nPhase 1 (encoder frozen)  lr=0.0001\n","output_type":"stream"},{"name":"stderr","text":"                                                      \r","output_type":"stream"},{"name":"stdout","text":"  ep1 loss=0.2835 | val macro=0.8863 rare=0.9247  ✅ saved\n","output_type":"stream"},{"name":"stderr","text":"                                                      \r","output_type":"stream"},{"name":"stdout","text":"  ep2 loss=0.1926 | val macro=0.8900 rare=0.9155  ✅ saved\n\nPhase 2 (end to end)  lr=3e-05\n","output_type":"stream"},{"name":"stderr","text":"                                                      \r","output_type":"stream"},{"name":"stdout","text":"  ep1 loss=0.1708 | val macro=0.9068 rare=0.9251  ✅ saved\n","output_type":"stream"},{"name":"stderr","text":"                                                      \r","output_type":"stream"},{"name":"stdout","text":"  ep2 loss=0.1416 | val macro=0.9066 rare=0.9210\n","output_type":"stream"},{"name":"stderr","text":"                                                      \r","output_type":"s