t":"2026-06-26T07:27:53.182274Z","iopub.status.idle":"2026-06-26T07:27:54.30838Z","shell.execute_reply.started":"2026-06-26T07:27:53.182245Z","shell.execute_reply":"2026-06-26T07:27:54.307454Z"}},"outputs":[{"name":"stdout","text":"  MEL    IL_6693472  loaded OK  ISIC_2783831.jpg\n  NV     IL_2222251  loaded OK  ISIC_2620875.jpg\n  BCC    IL_6491562  loaded OK  ISIC_1191996.jpg\n  DF     IL_3966322  loaded OK  ISIC_2948051.jpg\n  VASC   IL_5437959  loaded OK  ISIC_1803069.jpg\n  INF    IL_9439830  loaded OK  ISIC_1603958.jpg\n\nSaved: /kaggle/working/preview_selected.png  (1293 KB)\n","output_type":"stream"}],"execution_count":47},{"cell_type":"code","source":"# ═══════════════════════════════════════════════════════════════\n# STEP 33 — Reload SAM2 + generate Fig 6a and Fig 6b\n# ═══════════════════════════════════════════════════════════════\nimport torch, torch.nn as nn, numpy as np\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport pandas as pd, cv2\nfrom pathlib import Path\nfrom PIL import Image\nimport torchvision.transforms as T\nfrom pytorch_grad_cam import GradCAM\nfrom pytorch_grad_cam.utils.model_targets import ClassifierOutputTarget\nfrom pytorch_grad_cam.utils.image import show_cam_on_image\nfrom sam2.build_sam import build_sam2\nfrom sam2.sam2_image_predictor import SAM2ImagePredictor\n\nDEVICE     = 'cuda' if torch.cuda.is_available() else 'cpu'\nWORK       = Path('/kaggle/working')\nTRAIN_IMG_DIR = Path('/kaggle/input/datasets/cvaravinda/milkydatset/'\n                     'MILK10_2024/MILK10k_Training_Input/MILK10k_Training_Input')\n\nCLASSES    = ['AKIEC','BCC','BEN_OTH','BKL','DF','INF',\n              'MAL_OTH','MEL','NV','SCCKA','VASC']\nMONET_COLS = ['MONET_ulceration_crust','MONET_hair',\n              'MONET_vasculature_vessels','MONET_erythema',\n              'MONET_pigmented',\n              'MONET_gel_water_drop_fluid_dermoscopy_liquid',\n              'MONET_skin_markings_pen_ink_purple_pen']\nMINORITY   = ['INF','VASC','DF','MAL_OTH','BEN_OTH']\n\n# ── Reload SAM2 ───────────────────────────────────────────────\nprint('Loading SAM2...')\nsam2_model = build_sam2('sam2_hiera_s.yaml',\n                        '/kaggle/working/sam2/sam2_hiera_small.pt',\n                        device=DEVICE)\npredictor  = SAM2ImagePredictor(sam2_model)\nprint('SAM2 OK')\n\n# ── Load meta for MONET features ─────────────────────────────\nmeta_df = pd.read_csv('/kaggle/input/datasets/cvaravinda/milkydatset/'\n                      'MILK10_2024/MILK10k_Training_Metadata.csv')\nmeta_df = meta_df[meta_df['image_type']=='dermoscopic']\ncov_df  = pd.read_csv(WORK/'milk10k_sam2_coverage.csv')\nfor c in MONET_COLS:\n    if c not in meta_df.columns:\n        meta_df[c] = 0.0\n\n# ── GradCAM wrappers ──────────────────────────────────────────\ntfm = T.Compose([T.Resize((224,224)), T.ToTensor(),\n                 T.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])])\n\norig_target = [arcmed_orig.encoder.stream1.blocks[6][-1].bn2]\nma_target   = [model_sam2.base.encoder.stream1.blocks[6][-1].bn2]\n\nclass OrigWrap(nn.Module):\n    def __init__(self, mon):\n        super().__init__()\n        self.mon    = mon\n        self._dummy = nn.Parameter(torch.zeros(1), requires_grad=False)\n    def forward(self, x):\n        return arcmed_orig(x, self.mon.unsqueeze(0).to(x.device))\n\nclass MAWrap(nn.Module):\n    def __init__(self, mon, cov):\n        super().__init__()\n        self.mon    = mon\n        self.cov    = cov\n        self._dummy = nn.Parameter(torch.zeros(1), requires_grad=False)\n    def forward(self, x):\n        return model_sam2(x,\n            self.mon.unsqueeze(0).to(x.device),\n            self.cov.unsqueeze(0).to(x.device))\n\ndef get_cam(wrapper, tgt_layers, img_t, gt_idx):\n    wrapper.eval()\n    with GradCAM(model=wrapper, target_layers=tgt_layers) as cam:\n        out = cam(input_tensor=img_t.unsqueeze(0).to(DEVICE),\n                  targets=[ClassifierOutputTarget(gt_idx)])\n    return out[0]\n\ndef get_sam2_mask(img_np):\n    H, W   = img_np.shape[:2]\n    cx, cy = W//2, H//2\n    bw, bh = int(W*0.55), int(H*0.55)\n    box    = np.array([cx-bw//2, cy-bh//2, cx+bw//2, cy+bh//2])\n    predictor.set_image(img_np)\n    masks, scores, _ = predictor.predict(\n        box=box, multimask_output=False)\n    return masks[0].astype(bool), float(scores[0])\n\ndef er(cam_map, mask):\n    return float(cam_map[mask].sum()/(cam_map.sum()+1e-8))\n\ndef pg(cam_map, mask):\n    peak = np.unravel_index(cam_map.argmax(), cam_map.shape)\n    return bool(mask[peak])\n\n# ── Process one lesion → all pipeline data ────────────────────\ndef process(lid, gt_cls):\n    row_m = meta_df[meta_df['lesion_id']==lid]\n    monet_t = torch.tensor(\n        row_m.iloc[0][MONET_COLS].values.astype(np.float32)\n        if len(row_m) else np.zeros(7, np.float32))\n\n    cov_row = cov_df[cov_df['lesion_id']==lid]\n    cov_val = float(cov_row['coverage'].values[0]) if len(cov_row) else 0.24\n    cov_t   = torch.tensor(cov_val, dtype=torch.float32)\n    gt_idx  = CLASSES.index(gt_cls)\n\n    imgs    = list((TRAIN_IMG_DIR/lid).glob('*.jpg'))\n    img_pil = Image.open(imgs[0]).convert('RGB').resize((224,224))\n    img_np  = np.array(img_pil)\n    img_t   = tfm(img_pil)\n\n    mask, sam_score = get_sam2_mask(img_np)\n    if mask.sum() < 20:\n        mask = np.zeros((224,224), bool)\n        mask[56:168,56:168] = True\n\n    cam_o = get_cam(OrigWrap(monet_t).to(DEVICE),\n                    orig_target, img_t, gt_idx)\n    cam_m = get_cam(MAWrap(monet_t, cov_t).to(DEVICE),\n                    ma_target, img_t, gt_idx)\n\n    return dict(\n        img_np=img_np, mask=mask,\n        cam_o=cam_o,   cam_m=cam_m,\n        er_o=er(cam_o,mask), er_m=er(cam_m,mask),\n        pg_o=pg(cam_o,mask), pg_m=pg(cam_m,mask),\n        cov=cov_val,   sam=sam_score,\n        gt_cls=gt_cls, lid=lid)\n\n# ── Build figure ──────────────────────────────────────────────\ndef build_fig(lesion_list, title, save_path):\n    n   = len(lesion_list)\n    fig, axes = plt.subplots(n, 5, figsize=(22, n*4.5))\n    if n == 1: axes = axes[np.newaxis,:]\n\n    col_hdrs = ['Input image','SAM2 mask',\n                'Original GradCAM','MA-ARCMED GradCAM','Overlay']\n    for ax, h in zip(axes[0], col_hdrs):\n        ax.set_title(h, fontsize=11, fontweight='bold', pad=10)\n\n    for ri, (lid, gt_cls) in enumerate(lesion_list):\n        print(f'  Processing {gt_cls} {lid}...')\n        d   = process(lid, gt_cls)\n        img_f = d['img_np'].astype(np.float32)/255.\n\n        # Col 0 — raw image\n        axes[ri,0].imshow(d['img_np'])\n        tag = '⚡' if gt_cls in MINORITY else ''\n        axes[ri,0].set_ylabel(\n            f'{tag}{gt_cls}',\n            fontsize=12, fontweight='bold',\n            rotation=90, va='center', labelpad=10)\n\n        # Col 1 — SAM2 mask\n        mask_show = img_f.copy()\n        mask_show[d['mask']] = (mask_show[d['mask']]*0.4\n                                + np.array([0.,0.78,0.39])*0.6)\n        axes[ri,1].imshow(np.clip(mask_show,0,1))\n        axes[ri,1].set_xlabel(\n            f'cov={d[\"cov\"]:.2f}  sam={d[\"sam\"]:.2f}',\n            fontsize=8)\n\n        # Col 2 — original GradCAM\n        cam_o_r = cv2.resize(d['cam_o'],(224,224))\n        axes[ri,2].imshow(\n            show_cam_on_image(img_f, cam_o_r, use_rgb=True))\n        axes[ri,2].set_xlabel(\n            f'PG={\"✓\" if d[\"pg_o\"] else \"✗\"}  '\n            f'ER={d[\"er_o\"]*100:.1f}%',\n            fontsize=9)\n\n        # Col 3 — MA-ARCMED GradCAM\n        cam_m_r = cv2.resize(d['cam_m'],(224,224))\n        axes[ri,3].imshow(\n            show_cam_on_image(img_f, cam_m_r, use_rgb=True))\n        axes[ri,3].set_xlabel(\n            f'PG={\"✓\" if d[\"pg_m\"] else \"✗\"}  '\n            f'ER={d[\"er_m\"]*100:.1f}%',\n            fontsize=9)\n\n        # Col 4 — overlay\n        overlay = img_f.copy()\n        overlay[d['mask']] = (overlay[d['mask']]*0.55\n                              + np.array([0.,0.78,0.39])*0.45)\n        axes[ri,4].imshow(np.clip(overlay,0,1))\n\n        for ax in axes[ri]: ax.axis('off')\n        # re-enable ylabel axis for col 0\n        axes[ri,0].axis('on')\n        axes[ri,0].set_xticks([])\n        axes[ri,0].set_yticks([])\n        for spine in axes[ri,0].spines.values():\n            spine.set_visible(False)\n\n    fig.suptitle(title, fontsize=13, fontweight='bold', y=1.005)\n    plt.tight_layout()\n    fig.savefig(save_path, dpi=150, bbox_inches='tight')\n    plt.close()\n    size_kb = save_path.stat().st_size/1024\n    print(f'✅ {save_path.name}  ({size_kb:.0f} KB)')\n\n# ── Generate both figures ─────────────────────────────────────\nmajority = [('IL_6693472','MEL'),\n            ('IL_2222251','NV'),\n            ('IL_6491562','BCC')]\n\nminority = [('IL_3966322','DF'),\n            ('IL_5437959','VASC'),\n            ('IL_9439830','INF')]\n\nprint('\\nGenerating Fig 6a — majority classes...')\nbuild_fig(majority,\n    'Fig 6a — Majority Classes: SAM2 Segmentation + GradCAM Faithfulness',\n    WORK/'fig6a_majority.png')\n\nprint('\\nGenerating Fig 6b — minority classes...')\nbuild_fig(minority,\n    'Fig 6b — Minority Classes (Rare): SAM2 Segmentation + GradCAM Faithfulness',\n    WORK/'fig6b_minority.png')\n\n# ── Final status ──────────────────────────────────────────────\nprint()\nprint('='*55)\nfor f in ['fig1_rarederm_benchmark.png',\n          'fig6a_majority.png',\n          'fig6b_minority.png']:\n    p = WORK/f\n    s = f'✅ {p.stat().st_size/1024:.0f} KB' if p.exists() else '❌ MISSING'\n    print(f'  {f:<38} {s}')\nprint('='*55)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-26T07:31:23.498581Z","iopub.execute_input":"2026-06-26T07:31:23.499249Z","iopub.status.idle":"2026-06-26T07:31:32.335191Z","shell.execute_reply.started":"2026-06-26T07:31:23.49922Z","shell.execute_reply":"2026-06-26T07:31:32.334429Z"}},"outputs":[{"name":"stderr","text":"Exception ignored in: <function