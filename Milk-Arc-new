rom torch.utils.data import Dataset, DataLoader\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.model_selection import train_test_split\nfrom tqdm import tqdm\n\nDEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'\nWORK   = Path('/kaggle/working')\n\nCLASSES    = ['AKIEC','BCC','BEN_OTH','BKL','DF','INF',\n              'MAL_OTH','MEL','NV','SCCKA','VASC']\nMONET_COLS = ['MONET_ulceration_crust','MONET_hair',\n              'MONET_vasculature_vessels','MONET_erythema',\n              'MONET_pigmented',\n              'MONET_gel_water_drop_fluid_dermoscopy_liquid',\n              'MONET_skin_markings_pen_ink_purple_pen']\nMINORITY   = ['INF','VASC','DF','MAL_OTH','BEN_OTH']\nMILK10K    = Path('/kaggle/input/datasets/cvaravinda/milkydatset/MILK10_2024')\nTRAIN_IMG  = MILK10K/'MILK10k_Training_Input'/'MILK10k_Training_Input'\nCKPT_DIR   = Path('/kaggle/input/models/cvaravinda/checkpoints'\n                  '/pytorch/default/1/checkpoints')\nSWIN_CKPT  = Path('/kaggle/input/models/cvaravinda/swin'\n                  '/pytorch/default/1/best_swin_tiny.pt')\n\n# ── Rebuild val_df (same seed=42 split as training) ───────────\ngt   = pd.read_csv(MILK10K/'MILK10k_Training_GroundTruth.csv')\nmeta = pd.read_csv(MILK10K/'MILK10k_Training_Metadata.csv')\nderm = meta[meta['image_type']=='dermoscopic'].copy()\ndf   = derm.merge(gt, on='lesion_id', how='inner')\nfor c in MONET_COLS:\n    if c not in df.columns:\n        df[c] = 0.0\n\n_, val_df = train_test_split(\n    df, test_size=0.2, random_state=42,\n    stratify=df[CLASSES].values.argmax(1))\nval_df = val_df.reset_index(drop=True)\nprint(f'Val set: {len(val_df)} images')\n\n# ── Dataset ───────────────────────────────────────────────────\nclass ValDataset(Dataset):\n    def __init__(self, df):\n        self.df  = df\n        self.tfm = T.Compose([\n            T.Resize((224,224)), T.ToTensor(),\n            T.Normalize([0.485,0.456,0.406],\n                        [0.229,0.224,0.225])])\n    def __len__(self): return len(self.df)\n    def __getitem__(self, idx):\n        row   = self.df.iloc[idx]\n        imgs  = list((TRAIN_IMG/row['lesion_id']).glob('*.jpg'))\n        img_t = self.tfm(Image.open(imgs[0]).convert('RGB'))\n        monet = torch.tensor(\n            row[MONET_COLS].values.astype(np.float32))\n        label = torch.tensor(\n            row[CLASSES].values.astype(np.float32))\n        return img_t, monet, label\n\nval_ds     = ValDataset(val_df)\nval_loader = DataLoader(val_ds, batch_size=32, shuffle=False,\n                        num_workers=2, pin_memory=True)\n\n# ── Model registry ────────────────────────────────────────────\ndef build_model(model_key, num_classes=11):\n    if model_key == 'swin_tiny':\n        m = timm.create_model('swin_tiny_patch4_window7_224',\n                              pretrained=False, num_classes=num_classes)\n    elif model_key == 'efficientnet_b3':\n        m = timm.create_model('efficientnet_b3',\n                              pretrained=False, num_classes=num_classes)\n    elif model_key == 'regnety_8gf' or model_key == 'regnety_008':\n        try:\n            m = timm.create_model('regnety_008',\n                                  pretrained=False, num_classes=num_classes)\n        except:\n            m = timm.create_model('regnety_008gf',\n                                  pretrained=False, num_classes=num_classes)\n    elif model_key == 'convnext_tiny':\n        m = timm.create_model('convnext_tiny',\n                              pretrained=False, num_classes=num_classes)\n    elif model_key == 'maxvit_tiny':\n        m = timm.create_model('maxvit_tiny_tf_224',\n                              pretrained=False, num_classes=num_classes)\n    elif model_key == 'densenet121':\n        m = timm.create_model('densenet121',\n                              pretrained=False, num_classes=num_classes)\n    elif model_key == 'resnet50':\n        m = timm.create_model('resnet50',\n                              pretrained=False, num_