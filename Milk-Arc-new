mport Image\nfrom tqdm import tqdm\nfrom pytorch_grad_cam import GradCAM\nfrom pytorch_grad_cam.utils.model_targets import ClassifierOutputTarget\n\nDEVICE    = 'cuda' if torch.cuda.is_available() else 'cpu'\nSAVE_CSV  = Path('/kaggle/working/step3b_correct_metrics.csv')\n\nCLASSES    = ['AKIEC','BCC','BEN_OTH','BKL','DF','INF',\n              'MAL_OTH','MEL','NV','SCCKA','VASC']\nMONET_COLS = ['MONET_ulceration_crust','MONET_hair',\n              'MONET_vasculature_vessels','MONET_erythema',\n              'MONET_pigmented',\n              'MONET_gel_water_drop_fluid_dermoscopy_liquid',\n              'MONET_skin_markings_pen_ink_purple_pen']\n\nTRAIN_IMG_DIR = Path('/kaggle/input/datasets/cvaravinda/milkydatset/'\n                     'MILK10_2024/MILK10k_Training_Input/'\n                     'MILK10k_Training_Input')\n\n# ── Load 0.8787 model ─────────────────────────────────────────\nckpt_ma = torch.load('/kaggle/working/arcmed_ma_sam2.pt',\n                     map_location='cpu', weights_only=False)\nmodel_sam2.load_state_dict(ckpt_ma['model_state_dict'])\nmodel_sam2 = model_sam2.to(DEVICE)\nmodel_sam2.eval()\nprint(f'Model loaded  AUROC={ckpt_ma[\"macro_auroc\"]:.4f}')\n\n# Also need original ARCMED for comparison\narcmed_orig = ARCMEDV3().to(DEVICE)\nckpt_base   = torch.load(ARCMED_CKPT, map_location='cpu', weights_only=False)\narcmed_orig.load_state_dict(ckpt_base['model'], strict=False)\narcmed_orig.eval()\nprint(f'Baseline loaded AUROC={ckpt_base[\"macro_auroc\"]:.4f}')\n\n# ── GradCAM target layers ─────────────────────────────────────\n# stream1 last block bn for both models\norig_target  = [arcmed_orig.encoder.stream1.blocks[6][-1].bn2]\nma_target    = [model_sam2.base.encoder.stream1.blocks[6][-1].bn2]\n\n# ── SAM2 mask for each lesion (reuse predictor from Step 24) ──\nimport torchvision.transforms as T\n\ntfm = T.Compose([\n    T.Resize((224,224)),\n    T.ToTensor(),\n    T.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])])\n\ndef get_sam2_mask(img_np):\n    H, W   = img_np.shape[:2]\n    cx, cy = W//2, H//2\n    scale  = 0.55\n    bw, bh = int(W*scale), int(H*scale)\n    box    = np.array([cx-bw//2, cy-bh//2, cx+bw//2, cy+bh//2])\n    predictor.set_image(img_np)\n    masks, _, _ = predictor.predict(box=box, multimask_output=False)\n    return masks[0].astype(bool)   # (224,224)\n\ndef get_gradcam(model, target_layer, img_t, monet_t,\n                gt_idx, cov_t=None):\n    \"\"\"Returns saliency map (224,224) float32\"\"\"\n    # wrapper so GradCAM sees a single-input model\n    class Wrapper(torch.nn.Module):\n        def __init__(self, m, mon, cov):\n            super().__init__()\n            self.m   = m\n            self.mon = mon\n            self.cov = cov\n        def forward(self, x):\n            if self.cov is not None:\n                return self.m(x, self.mon, self.cov)\n            return self.m(x, self.mon)\n\n    mon  = monet_t.unsqueeze(0).to(DEVICE)\n    cov  = cov_t.unsqueeze(0).to(DEVICE) if cov_t is not None else None\n    wrap = Wrapper(model, mon, cov)\n\n    with GradCAM(model=wrap, target_layers=target_layer) as cam:\n        grayscale = cam(\n            input_tensor=img_t.unsqueeze(0).to(DEVICE),\n            targets=[ClassifierOutputTarget(gt_idx)])\n    return grayscale[0]   # (224,224)\n\ndef pointing_game(cam_map, mask):\n    \"\"\"Peak pixel of CAM inside mask?\"\"\"\n    peak = np.unravel_index(cam_map.argmax(), cam_map.shape)\n    return float(mask[peak])\n\ndef energy_ratio(cam_map, mask):\n    \"\"\"Fraction of CAM energy inside mask\"\"\"\n    total = cam_map.sum() + 1e-8\n    return float(cam_map[mask].sum() / total)\n\n# ── Stratified 289-lesion sample ─────────────────────────────\ngt   = pd.read_csv('/kaggle/input/datasets/cvaravinda/milkydatset/'\n                   'MILK10_2024/MILK10k_Training_GroundTruth.csv')\nmeta = pd.read_csv('/kaggle/input/datasets/cvaravinda/milkydatset/'\n                   'MILK10_2024/MILK10k_Training_Metadata.csv')\ncov_df = pd.read_csv('/kaggle/working/milk10k_sam2_coverage.csv')\n\nderm = meta[meta['image_type']=='dermoscopic'].copy()\ndf   = derm.merge(gt, on='lesion_id', how='inner')\ndf   = df.merge(cov_df[['lesion_id','coverage']],\n                on='lesion_id', how='left')\ndf['coverage'] = df['coverage'].fillna(0.240)\nfor c in MONET_COLS:\n    if c not in df.columns:\n        df[c] = 0.0\n\n# Stratified sample: 28 per class (MAL_OTH capped at 9)\nMINORITY = ['INF','VASC','DF','MAL_OTH','BEN_OTH']\nper_class = 28\nsampled = []\nfor cls in CLASSES:\n    cls_df = df[df[cls]==1]\n    n      = min(per_class, len(cls_df))\n    sampled.append(cls_df.sample(n, random_state=42))\neval_df = pd.concat(sampled).drop_duplicates('lesion_id').reset_index(drop=True)\nprint(f'Eval set: {len(eval_df)} lesions')\nfor cls in CLASSES:\n    n   = eval_df[cls].sum()\n    tag = '⚡' if cls in MINORITY else '  '\n    print(f'  {tag}{cls:<10}: {int(n)}')\n\n# ── Main eval loop ────────────────────────────────────────────\nrecords = []\npg_orig_list, pg_ma_list = [], []\ner_orig_list, er_ma_list = [], []\n\nprint()\nprint('='*60)\nprint('Running Step 3B faithfulness evaluation...')\nprint('='*60)\n\nfor _, row in tqdm(eval_df.iterrows(), total=len(eval_df)):\n    lid    = row['lesion_id']\n    gt_cls = [c for c in CLASSES if row[c]==1][0]\n    gt_idx = CLASSES.index(gt_cls)\n    cov    = float(row['coverage'])\n\n    # Load image\n    imgs   = list((TRAIN_IMG_DIR/lid).glob('*.jpg'))\n    if not imgs:\n        continue\n    img_np = np.array(Image.open(imgs[0]).convert('RGB').resize((224,224)))\n    img_t  = tfm(Image.open(imgs[0]).convert('RGB'))\n    monet_t= torch.tensor(\n        row[MONET_COLS].values.astype(np.float32))\n    cov_t  = torch.tensor(cov, dtype=torch.float32)\n\n    # SAM2 mask\n    try:\n        mask = get_sam2_mask(img_np)\n        if mask.sum() < 10:\n            mask = np.zeros((224,224), dtype=bool)\n            mask[56:168, 56:168] = True\n    except:\n        mask = np.zeros((224,224),