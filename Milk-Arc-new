ILK10_2024/MILK10k_Training_Input/MILK10k_Training_Input')\n\ntfm = T.Compose([T.Resize((224,224)), T.ToTensor(),\n                 T.Normalize([0.485,0.456,0.406],\n                             [0.229,0.224,0.225])])\n\n# Load support data\nres_df  = pd.read_csv(WORK/'step3b_correct_metrics.csv')\ncov_df  = pd.read_csv(WORK/'milk10k_sam2_coverage.csv')\nmeta_df = pd.read_csv('/kaggle/input/datasets/cvaravinda/milkydatset/'\n                      'MILK10_2024/MILK10k_Training_Metadata.csv')\nmeta_df = meta_df[meta_df['image_type']=='dermoscopic']\nfor c in MONET_COLS:\n    if c not in meta_df.columns:\n        meta_df[c] = 0.0\n\norig_target = [arcmed_orig.encoder.stream1.blocks[6][-1].bn2]\nma_target   = [model_sam2.base.encoder.stream1.blocks[6][-1].bn2]\n\n# ── Wrappers ──────────────────────────────────────────────────\nclass OrigWrapper(nn.Module):\n    def __init__(self, model, monet_t):\n        super().__init__()\n        self.model   = model\n        self.monet_t = monet_t\n        self._dummy  = nn.Parameter(torch.zeros(1), requires_grad=False)\n    def forward(self, x):\n        return self.model(x, self.monet_t.unsqueeze(0).to(x.device))\n\nclass MAWrapper(nn.Module):\n    def __init__(self, model, monet_t, cov_t):\n        super().__init__()\n        self.model   = model\n        self.monet_t = monet_t\n        self.cov_t   = cov_t\n        self._dummy  = nn.Parameter(torch.zeros(1), requires_grad=False)\n    def forward(self, x):\n        return self.model(x,\n            self.monet_t.unsqueeze(0).to(x.device),\n            self.cov_t.unsqueeze(0).to(x.device))\n\ndef get_cam(wrapper, target_layers, img_t, gt_idx):\n    wrapper.eval()\n    with GradCAM(model=wrapper, target_layers=target_layers) as cam:\n        out = cam(input_tensor=img_t.unsqueeze(0).to(DEVICE),\n                  targets=[ClassifierOutputTarget(gt_idx)])\n    return out[0]   # (224,224)\n\ndef energy_ratio(cam_map, mask):\n    return float(cam_map[mask].sum() / (cam_map.sum() + 1e-8))\n\ndef pointing_game(cam_map, mask):\n    peak = np.unravel_index(cam_map.argmax(), cam_map.shape)\n    return float(mask[peak])\n\ndef get_sam2_mask(img_np):\n    H, W   = img_np.shape[:2]\n    cx, cy = W//2, H//2\n    bw, bh = int(W*0.55), int(H*0.55)\n    box    = np.array([cx-bw//2, cy-bh//2, cx+bw//2, cy+bh//2])\n    predictor.set_image(img_np)\n    masks, _, _ = predictor.predict(box=box, multimask_output=False)\n    return masks[0].astype(bool)\n\ndef get_pipeline_data(lid, gt_cls):\n    row_m = meta_df[meta_df['lesion_id']==lid]\n    if row_m.empty: return None\n    row_m   = row_m.iloc[0]\n    imgs    = list((TRAIN_IMG_DIR/lid).glob('*.jpg'))\n    if not imgs: return None\n\n    img_pil = Image.open(imgs[0]).convert('RGB').resize((224,224))\n    img_np  = np.array(img_pil)\n    img_t   = tfm(img_pil)\n    monet_t = torch.tensor(row_m[MONET_COLS].values.astype(np.float32))\n    cov_row = cov_df[cov_df['lesion_id']==lid]\n    cov_val = float(cov_row['coverage'].values[0]) if len(cov_row) else 0.24\n    cov_t   = torch.tensor(cov_val, dtype=torch.float32)\n    gt_idx  = CLASSES.index(gt_cls)\n\n    try:\n        mask = get_sam2_mask(img_np)\n        if mask.sum() < 20:\n            mask = np.zeros((224,224), bool)\n            mask[56:168,56:168] = True\n    except:\n        mask = np.zeros((224,224), bool)\n        mask[56:168,56:168] = True\n\n    w_o = OrigWrapper(arcmed_orig, monet_t).to(DEVICE)\n    w_m = MAWrapper(model_sam2, monet_t, cov_t).to(DEVICE)\n\n    try:\n        cam_o = get_cam(w_o, orig_target, img_t, gt_idx)\n    except: cam_o = np.zeros((224,224), np.float32)\n    try:\n        cam_m = get_cam(w_m, ma_target, img_t, gt_idx)\n    except: cam_m = np.zeros((224,224), np.float32)\n\n    er_o = energy_ratio(cam_o, mask)\n    er_m = energy_ratio(cam_m, mask)\n    pg_o = pointing_game(cam_o, mask)\n    pg_m = pointing_game(cam_m, mask)\n\n    return dict(img_np=img_np, mask=mask,\n                cam_o=cam_o, cam_m=cam_m,\n                cov=