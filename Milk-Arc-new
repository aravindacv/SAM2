 pytorch_grad_cam import GradCAM\nfrom pytorch_grad_cam.utils.model_targets import ClassifierOutputTarget\n\nDEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'\n\nMONET_COLS = ['MONET_ulceration_crust','MONET_hair',\n              'MONET_vasculature_vessels','MONET_erythema',\n              'MONET_pigmented',\n              'MONET_gel_water_drop_fluid_dermoscopy_liquid',\n              'MONET_skin_markings_pen_ink_purple_pen']\n\n# ── Wrapper that owns a dummy param so GradCAM finds device ───\nclass OrigWrapper(nn.Module):\n    def __init__(self, model, monet_t):\n        super().__init__()\n        self.model   = model\n        self.monet_t = monet_t\n        self._dummy  = nn.Parameter(torch.zeros(1), requires_grad=False)\n    def forward(self, x):\n        return self.model(x, self.monet_t.unsqueeze(0).to(x.device))\n\nclass MAWrapper(nn.Module):\n    def __init__(self, model, monet_t, cov_t):\n        super().__init__()\n        self.model   = model\n        self.monet_t = monet_t\n        self.cov_t   = cov_t\n        self._dummy  = nn.Parameter(torch.zeros(1), requires_grad=False)\n    def forward(self, x):\n        return self.model(x,\n            self.monet_t.unsqueeze(0).to(x.device),\n            self.cov_t.unsqueeze(0).to(x.device))\n\ndef get_cam(wrapper, target_layers, img_t, gt_idx):\n    wrapper.eval()\n    cam = GradCAM(model=wrapper, target_layers=target_layers)\n    out = cam(input_tensor=img_t.unsqueeze(0).to(DEVICE),\n              targets=[ClassifierOutputTarget(gt_idx)])\n    del cam\n    return out[0]\n\n# ── Quick smoke test ──────────────────────────────────────────\nimport torchvision.transforms as T\nfrom PIL import Image\nfrom pathlib import Path\n\nTRAIN_IMG_DIR = Path('/kaggle/input/datasets/cvaravinda/milkydatset/'\n                     'MILK10_2024/MILK10k_Training_Input/MILK10k_Training_Input')\ntfm = T.Compose([T.Resize((224,224)), T.ToTensor(),\n                 T.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])])\n\nfirst