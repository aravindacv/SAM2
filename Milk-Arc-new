= tfm(Image.open(IMGDIR/r.lesion_id/f'{r.isic_id}.jpg').convert('RGB'))[None].to(DEVICE)\n    mon = torch.tensor(r[MONET].values.astype(np.float32))[None].to(DEVICE)\n    cvt = torch.tensor([float(r.coverage)], device=DEVICE)\n    cls = CLASSES[int(np.argmax(r[CLASSES].values))]\n    tgt = [ClassifierOutputTarget(CLASSES.index(cls))]\n    W_b.mon = W_g.mon = mon; W_g.cov = cvt\n    out = {'lesion_id': r.lesion_id, 'cls': cls, 'rare': cls in MINORITY, 'coverage': r.coverage}\n    for tag, cam in [('orig', cam_b), ('gated', cam_g)]:\n        L = cam(input_tensor=x, targets=tgt)[0]\n        peak = np.unravel_index(L.argmax(), L.shape)\n        out[f'pg_{tag}'] = float(mask[peak])\n        out[f'er_{tag}'] = float(L[mask].sum() / (L.sum() + 1e-8))\n    rows.append(out)\n\nA = pd.DataFrame(rows); A.to_csv('/kaggle/working/faithfulness_TEST_derm.csv', index=False)\np_pg = wilcoxon(A.pg_gated, A.pg_orig, zero_method='zsplit').pvalue\np_er = wilcoxon(A.er_gated, A.er_orig).pvalue\np_mw = mannwhitneyu(A[A.rare].er_orig, A[~A.rare].er_orig).pvalue\narea = A.coverage.mean()\n\nprint('\\n' + '='*62)\nprint(f'FAITHFULNESS — held-out test lesions (n={len(A)}, rare={int(A.rare.sum())})')\nprint(f'  Mean SAM2 mask area (chance level for ER) = {area:.3f}')\nprint(f'  Pointing game  original {A.pg_orig.mean()*100:5.1f}%  →  gated {A.pg_gated.mean()*100:5.1f}%   Wilcoxon p={p_pg:.4f}')\nprint(f'  Energy ratio   original {A.er_orig.mean()*100:5.1f}%  →  gated {A.er_gated.mean()*100:5.1f}%   Wilcoxon p={p_er:.4f}')\nprint(f'  Rare vs majority ER (original): {A[A.rare].er_orig.mean():.3f} vs {A[~A.rare].er_orig.mean():.3f}  '\n      f'Mann–Whitney p={p_mw:.3f}')\nprint('\\nPer class (n, PG orig→gated, ER orig→gated):')\nfor c in CLASSES:\n    s = A[A.cls == c]\n    if len(s): print(f'  {\"†\" if c in MINORITY else \" \"}{c:<8} n={len(s):>3}  '\n                     f'PG {s.pg_orig.mean()*100:5.1f}→{s.pg_gated.mean()*100:5.1f}%  '\n                     f'ER {s.er_orig.mean()*100:5.1f}→{s.er_gated.mean()*100:5.1f}%')\nprint('='*62)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T05:43:18.673117Z","iopub.execute_input":"2026-10-24T05:43:18.673558Z","iopub.status.idle":"2026-10-24T05:46:00.705957Z","shell.execute_reply.started":"2026-10-24T05:43:18.673519Z","shell.execute_reply":"2026-10-24T05:46:00.705185Z"}},"outputs":[{"name":"stdout","text":"     ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 7.8/7.8 MB 87.7 MB/s eta 0:00:00\n","output_type":"stream"},{"name":"stderr","text":"Grad-CAM audit: 100%|██████████| 778/778 [02:29<00:00,  5.21it/s]\n","output_type":"stream"},{"name":"stdout","text":"\n==============================================================\nFAITHFULNESS — held-out test lesions (n=775, rare=32)\n  Mean SAM2 mask area (chance level for ER) = 0.228\n  Pointing game  original  14.8%  →  gated  14.8%   Wilcoxon p=1.0000\n  Energy ratio   original  19.7%  →  gated  20.5%   Wilcoxon p=0.7408\n  Rare vs majority ER (original): 0.184 vs 0.197  Mann–Whitney p=0.720\n\nPer class (n, PG orig→gated, ER orig→gated):\n   AKIEC    n= 46  PG  21.7→ 26.1%  ER  21.7→ 24.3%\n   BCC      n=356  PG  20.8→ 12.4%  ER  25.7→ 20.0%\n  †BEN_OTH  n=  8  PG  25.0→ 37.5%  ER  21.0→ 31.1%\n   BKL      n= 85  PG  11.8→ 15.3%  ER  18.1→ 23.4%\n  †DF       n=  5  PG  40.0→ 80.0%  ER  25.3→ 39.4%\n  †INF      n= 11  PG   9.1→ 36.4%  ER  19.6→ 38.5%\n  †MAL_OTH  n=  3  PG  33.3→  0.0%  ER  23.2→ 21.1%\n   MEL      n= 79  PG   3.8→  5.1%  ER  10.9→ 11.3%\n   NV       n=109  PG   3.7→ 20.2%  ER  11.3→ 26.1%\n   SCCKA    n= 68  PG  11.8→ 13.2%  ER  13.0→ 14.5%\n  †VASC     n=  5  PG   0.0→  0.0%  ER   1.6→  1.4%\n==============================================================\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}