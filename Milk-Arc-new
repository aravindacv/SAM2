 for s in sites_top4])\nprint(f'Option A: {len(feat_A)} features')\nprint(feat_A)\n\n# Option B: 7 MONET + age + sex + 5 skin_tone dummies\ntone_dummies = pd.get_dummies(\n    derm['skin_tone_class'].fillna(0).astype(int),\n    prefix='tone')\nprint(f'\\nTone dummies: {list(tone_dummies.columns)}')\nprint(f'Option B: 7+1+1+{tone_dummies.shape[1]} = '\n      f'{7+1+1+tone_dummies.shape[1]} features')\n\n# Option C: 7 MONET + age_approx_raw + sex + skin_tone +\n#           4 site flags + image_manipulation\nprint(f'\\nimage_manipulation unique:')\nprint(derm['image_manipulation'].unique())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-26T08:03:14.892782Z","iopub.execute_input":"2026-06-26T08:03:14.893528Z","iopub.status.idle":"2026-06-26T08:03:14.953582Z","shell.execute_reply.started":"2026-06-26T08:03:14.893497Z","shell.execute_reply":"2026-06-26T08:03:14.952906Z"}},"outputs":[{"name":"stdout","text":"Option A: 14 features\n['MONET_ulceration_crust', 'MONET_hair', 'MONET_vasculature_vessels', 'MONET_erythema', 'MONET_pigmented', 'MONET_gel_water_drop_fluid_dermoscopy_liquid', 'MONET_skin_markings_pen_ink_purple_pen', 'age_norm', 'sex_enc', 'tone_enc', 'site_head_neck_face', 'site_lower_extremity', 'site_upper_extremity', 'site_trunk']\n\nTone dummies: ['tone_0', 'tone_1', 'tone_2', 'tone_3', 'tone_4', 'tone_5']\nOption B: 7+1+1+6 = 15 features\n\nimage_manipulation unique:\n['instrument only' 'altered']\n","output_type":"stream"}],"execution_count":72},{"cell_type":"code","source":"# ═══════════════════════════════════════════════════════════════\n# OBJ 8 FIX 11 — Evaluate all 3 remaining models\n# ═══════════════════════════════════════════════════════════════\nimport torch, torch.nn as nn, numpy as np, pandas as pd\nimport torchvision.models as tvm\nimport torchvision.transforms as T\nfrom pathlib import Path\nfrom PIL import Image\nfrom torch.utils.data import Dataset, DataLoader\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.model_selection import train_test_split\n\nDEVICE   = 'cuda' if torch.cuda.is_available() else 'cpu'\nCKPT_DIR = Path('/kaggle/input/models/cvaravinda/checkpoints'\n                '/pytorch/default/1/checkpoints')\nMILK10K  = Path('/kaggle/input/datasets/cvaravinda/milkydatset/MILK10_2024')\nTRAIN_IMG= MILK10K/'MILK10k_Training_Input'/'MILK10k_Training_Input'\nCLASSES  = ['AKIEC','BCC','BEN_OTH','BKL','DF','INF',\n            'MAL_OTH','MEL','NV','SCCKA','VASC']\nMINORITY = ['INF','VASC','DF','MAL_OTH','BEN_OTH']\n\n# ── 14 feature names ──────────────────────────────────────────\nMONET_COLS = ['MONET_ulceration_crust','MONET_hair',\n              'MONET_vasculature_vessels','MONET_erythema',\n              'MONET_pigmented',\n              'MONET_gel_water_drop_fluid_dermoscopy_liquid',\n              'MONET_skin_markings_pen_ink_purple_pen']\nMETA14 = (MONET_COLS +\n          ['age_norm','sex_enc','tone_enc',\n           'site_head_neck_face','site_lower_extremity',\n           'site_upper_extremity','site_trunk'])\n\n# ── Build val df with 14 features ────────────────────────────\ngt   = pd.read_csv(MILK10K/'MILK10k_Training_GroundTruth.csv')\nmeta = pd.read_csv(MILK10K/'MILK10k_Training_Metadata.csv')\nderm = meta[meta['image_type']=='dermoscopic'].copy()\n\n# Engineer features\nderm['age_norm'] = derm['age_approx'].fillna(50)/100.\nderm['sex_enc']  = (derm['sex']=='male').astype(float)\nderm['tone_enc'] = derm['skin_tone_class'].fillna(3)/6.\nfor s in ['head_neck_face','lower_extremity',\n          'upper_extremity','trunk']:\n    derm[f'site_{s}'] = (derm['site']==s).astype(float)\n\ndf14 = derm.merge(gt, on='lesion_id', how='inner')\nfor c in META14:\n    if c not in df14.columns:\n        df14[c] = 0.0\ndf14[META14] = df14[META14].fillna(0.0)\n\n_, val14 = train_test_split(\n    df14, test_size=0.2, random_state=42,\n    stratify=df14[CLASSES].values.argmax(1))\nval14 = val14.reset_index(drop=True)\nprint(f'Val14: {len(val14)} samples  features={len(META14)}')\n\n# ── Dataset ───────────────────────────────────────────────────\nclass Val14Dataset(Dataset):\n    def __init__(self, df):\n        self.df  = df\n        self.tfm = T.Compose([\n            T.Resize((224,224)), T.ToTensor(),\n            T.Normalize([0.485,0.456,0.406],\n                        [0.229,0.224,0.225])])\n    def __len__(self): return len(self.df)\n    def __getitem__(self, idx):\n        row   = self.df.iloc[idx]\n        imgs  = list((TRAIN_IMG/row['lesion_id']).glob('*.jpg'))\n        img_t = self.tfm(Image.open(imgs[0]).convert('RGB'))\n        meta  = torch.tensor(\n            row[META14].values.astype(np.float32))\n        label = torch.tensor(\n            row[CLASSES].values.astype(np.float32))\n        return img_t, meta, label\n\nval14_loader = DataLoader(\n    Val14Dataset(val14), batch_size=32,\n    shuffle=False, num_workers=2, pin_memory=True)\n\n# ── Architectures ─────────────────────────────────────────────\nclass DenseNet121Custom(nn.Module):\n    def __init__(self, nc=11):\n        super().__init__()\n        base = tvm.densenet121(weights=None)\n        self.features   = base.features\n        self.classifier = nn.Sequential(\n            nn.BatchNorm1d(1024), nn.ReLU(),\n            nn.Linear(1024, nc))\n    def forward(self, x, m=None):\n        f = self.features(x)\n        f = nn.functional.adaptive_avg_pool2d(f,1).flatten(1)\n        return self.classifier(f)\n\nclass ResNet50Custom(nn.Module):\n    def __init__(self, nc=11):\n        super().__init__()\n        base = tvm.resnet50(weights=None)\n        self.conv1=base.conv1; self.bn1=base.bn1\n        self.relu=base.relu;   self.maxpool=base.maxpool\n        self.layer1=base.layer1; self.layer2=base.layer2\n        self.layer3=base.layer3; self.layer4=base.layer4\n        self.avgpool=base.avgpool\n        self.fc = nn.Sequential(\n            nn.BatchNorm1d(2048), nn.ReLU(),\n            nn.Linear(2048, nc))\n    def forward(self, x, m=None):\n        x = self.maxpool(self.relu(self.bn1(self.conv1(x))))\n        x = self.layer4(self.layer3(\n            self.layer2(self.layer1(x))))\n        return self.fc(self.avgpool(x).flatten(1))\n\nclass EffNetMetaCustom(nn.Module):\n    def __init__(self, nc=11, n_meta=14):\n        super().__init__()\n        base = tvm.efficientnet_b3(weights=None)\n        base.classifier = nn.Identity()\n        self.backbone = base\n        self.meta_enc = nn.Sequential(\n            nn.Linear(n_meta, 64), nn.ReLU(),\n            nn.Linear(64, 128))\n        self.head = nn.Sequential(\n            nn.Linear(1536+128, 512), nn.ReLU(),\n            nn.Dropout(0.3), nn.Linear(512, nc))\n    def forward(self, x, meta=None):\n        f = self.backbone(x)\n        if meta is not None:\n            f = torch.cat([f, self.meta_enc(meta)], dim=1)\n        return self.head(f)\n\n# ── Eval function ─────────────────────────────────────────────\ndef eval_m(model, loader, use_meta=False):\n    model.eval()\n    all_logits, all_labels = [], []\n    with torch.no_grad():\n        for imgs, metas, labels in loader:\n            out = model(imgs.to(DEVICE),\n                        metas.to(DEVICE)) if use_meta \\\n                  else model(imgs.to(DEVICE))\n            all_logits.append(out.cpu())\n            all_labels.append(labels)\n    logits = torch.cat(all_logits).numpy()\n    labels = torch.cat(all_labels).numpy()\n    probs  = 1/(1+np.exp(-logits))\n    aurocs = {cls: float(roc_auc_score(labels[:,i], probs[:,i]))\n              for i, cls in enumerate(CLASSES)\n              if labels[:,i].sum() > 0}\n    macro = float(np.nanmean(list(aurocs.values())))\n    rare  = float(np.nanmean(\n        [aurocs[c] for c in MINORITY if c in aurocs]))\n    return macro, rare, aurocs\n\n# ── Run 3 models ──────────────────────────────────────────────\nfix_models = {\n    'DenseNet-121'  : (DenseNet121Custom(),\n                       CKPT_DIR/'best_densenet121.pt', False,\n                       val_loader),\n    'ResNet